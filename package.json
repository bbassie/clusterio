{
	"name": "root",
	"private": true,
	"files": [],
	"packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
	"type": "module",
	"scripts": {
		"build": "tsc --build",
		"watch": "tsc --build --watch",
		"build-mod": "pnpm run -r build-mod --output-dir ../../dist",
		"test": "pnpm run build && NODE_EXTRA_CA_CERTS=$(pwd)/test/file/tls/cert.pem mocha --enable-source-maps --check-leaks -R spec --recursive test \"plugins/*/test/**\" --exclude \"test/manual/**\"",
		"silent-test": "SILENT_TEST=y pnpm test",
		"fast-test": "FAST_TEST=y pnpm test",
		"no-external-test": "NO_EXTERNAL_TEST=y pnpm test",
		"cover": "nyc pnpm test",
		"fast-cover": "FAST_TEST=y nyc pnpm test",
		"ci-cover": "nyc --reporter=lcovonly pnpm run-script test",
		"lint": "eslint packages plugins test",
		"lint-fix": "eslint --fix packages plugins test",
		"clean": "node ./clean.js",
		"docs": "typedoc",
		"bundle-dependencies": "bundle-dependencies"
	},
	"nyc": {
		"exclude": [
			"test/**",
			"plugins/*/test/**"
		]
	},
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*",
		"plugins/*",
		"external_plugins/*",
		"external_plugins/*/*"
	],
	"devDependencies": {
		"@clusterio/controller": "workspace:^",
		"@clusterio/ctl": "workspace:^",
		"@clusterio/host": "workspace:^",
		"@clusterio/lib": "workspace:^",
		"@clusterio/web_ui": "workspace:^",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@swc/core": "catalog:",
		"@types/node": "catalog:",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.10.0",
		"eslint-plugin-node": "^11.1.0",
		"express": "catalog:",
		"form-data": "^4.0.6",
		"globals": "^17.12.0",
		"jsonwebtoken": "catalog:",
		"jszip": "catalog:",
		"mocha": "^11.8.0",
		"nyc": "^18.0.0",
		"typedoc": "^0.28.20",
		"typescript": "catalog:",
		"yargs": "catalog:"
	}
}
